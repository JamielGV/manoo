# Copy real values into Vercel's project Environment Variables — never
# commit an actual .env file. This one is just documentation.

# From Lemon Squeezy: Settings -> Webhooks -> (create one pointing at your
# Vercel deployment URL + /api/webhook) -> Signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=

# The exact contents of licensing/private-key.pem (multi-line PEM,
# including the BEGIN/END lines). This is the same key mint-license.mjs
# uses locally — never share it, never commit it, only Corporación Jamiel
# should hold it.
MANOO_PRIVATE_KEY=

# From resend.com after verifying a sending domain.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
FROM_EMAIL=ventas@example.com
